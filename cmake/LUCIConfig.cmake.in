@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenGL)
if(NOT @LUCI_USE_VENDORED_FREETYPE@)
    find_dependency(Freetype)
endif()

if(UNIX AND NOT APPLE)
    find_dependency(X11 QUIET)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/LUCITargets.cmake")
check_required_components(LUCI)
